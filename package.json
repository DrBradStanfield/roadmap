{
  "name": "health-tool",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "react-router build",
    "build:widget": "cd widget-src && npm run build",
    "build:pages": "cd widget-src && vite build --config vite.config.standalone.ts && PAGES_BUILD=1 vite build --config vite.config.upload.ts --outDir dist-pages",
    "build:shopify-prod": "cd widget-src && vite build --config vite.config.shopify-prod.ts && vite build --config vite.config.upload.ts --outDir ../extensions/health-tool-widget/assets",
    "dev": "shopify app dev",
    "dev:widget": "cd widget-src && npm run dev",
    "dev:pages": "cd widget-src && vite --config vite.config.standalone.ts",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "NODE_OPTIONS='--import ./instrument.server.mjs' react-router-serve ./build/server/index.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "vite": "vite",
    "check:symlinks": "node scripts/check-symlinks.mjs",
    "test": "npm run check:symlinks && npm run test:core && npm run test:server",
    "test:all": "vitest run",
    "test:core": "npm run test --workspace=@roadmap/health-core",
    "test:server": "vitest run app/lib",
    "test:watch": "npm run test --workspace=@roadmap/health-core -- --watch",
    "rebuild-index": "npx tsx scripts/rebuild-blog-index.ts"
  },
  "type": "module",
  "engines": {
    "node": "^20.10 || >=21.0.0"
  },
  "dependencies": {
    "@react-router/dev": "^7.17.0",
    "@react-router/fs-routes": "^7.17.0",
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@sentry/react-router": "^10.57.0",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-postgresql": "^6.0.0",
    "@supabase/supabase-js": "^2.93.2",
    "@types/jsonwebtoken": "^9.0.10",
    "discord.js": "^14.26.3",
    "isbot": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.17.0",
    "resend": "^6.9.2",
    "vite-tsconfig-paths": "^5.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@shopify/app-bridge-ui-types": "^0.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.2.0",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.2.2"
  },
  "workspaces": [
    "packages/*",
    "widget-src"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "minimatch": "9.0.9",
    "vite": "^6.2.2"
  },
  "overrides": {
    "minimatch": "9.0.9",
    "tar": "^7.5.11",
    "vite": "^6.2.2"
  },
  "author": "bradstanfield"
}
