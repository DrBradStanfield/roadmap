{
  // CI dependency-audit gate (replaces `npm audit --production --audit-level=high`).
  // Fails on NEW high/critical advisories in production deps. An advisory with no
  // non-breaking fix may be allowlisted below, but only WITH a documented reason and
  // a removal trigger. The list is empty today.
  //
  // Emptied 2026-10-14: audit-ci reported all six entries stale ("Consider not
  // allowlisting"). The five react-router advisories (GHSA-wrjc-x8rr-h8h6,
  // -h8fp-f39c-q6mh, -337j-9hxr-rhxg, -chx6-hx7r-mcp5, -qwww-vcr4-c8h2) are fixed in
  // 7.18.0 / 7.18.2, and 7.18.3 is installed (package.json ^7.18.3). The esbuild
  // advisory GHSA-gv7w-rqvm-qjhr was withdrawn 2026-06-17. A stale entry would hide
  // the advisory if it ever fired again (a downgrade, a nested copy).
  // If GHSA-gv7w is ever reinstated: esbuild 0.25.x ships in the prod image (vite via
  // @react-router/dev, a `dependencies` entry the Dockerfile build needs), but the
  // advisory hits only esbuild's Deno installer, which this repo never uses.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": []
}
