{
  // CI dependency-audit gate (replaces `npm audit --production --audit-level=high`).
  // Fails on NEW high/critical advisories in production deps; known-stuck advisories
  // with no non-breaking fix are allowlisted below WITH their exit plan. Don't add
  // to the allowlist without a documented reason + removal trigger.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "skip-dev": true,
  "allowlist": [
    // turbo-stream <3.0.0 — REMOVED 2026-06-14 with the React Router 7 migration.
    // RR7 (>=7.17) vendors a patched turbo-stream internally and no longer has an
    // external `turbo-stream` dependency, so the advisory no longer fires.
    // `npm ls turbo-stream` → empty. audit-ci confirmed: "Consider not allowlisting
    // advisory: GHSA-rxv8-25v2-qmq8".
    //
    // esbuild >=0.17 <0.28.1 — RCE via NPM_CONFIG_REGISTRY in esbuild's DENO
    // installer (published 2026-06-12). Not applicable: this repo never installs
    // esbuild via Deno; the npm install path is unaffected. esbuild is still in the
    // prod tree because @react-router/dev (a `dependencies` entry — the Dockerfile
    // runs `npm ci --omit=dev` THEN `react-router build`, so the build toolchain must
    // ship in the prod image) pulls vite -> esbuild@0.25.x. It is a build-time-only
    // binary, never invoked at runtime. REMOVE this entry once vite/@react-router/dev
    // resolve esbuild >=0.28.1.
    "GHSA-gv7w-rqvm-qjhr"
  ]
}
