<DocumentFragment>
  <div
    aria-label="Health by Dr Brad Chat"
    class="chat-section chat-expanded no-print"
    data-clarity-mask="true"
    role="dialog"
  >
    <div
      class="chat-header"
    >
      <button
        class="chat-threads-btn"
      >
        History
      </button>
      <div
        class="chat-header-title-block"
      >
        <h3
          tabindex="-1"
        >
          Discuss your health
        </h3>
        <p
          class="chat-header-sub"
        >
          Answers cite your plan & the guidelines above
        </p>
      </div>
      <button
        aria-label="Close chat"
        class="chat-close-btn"
      >
        ✕
      </button>
    </div>
    <div
      class="chat-body"
    >
      <div
        class="chat-key-gate"
      >
        <p
          class="chat-key-gate-title"
        >
          This chat runs on Claude (Anthropic)
        </p>
        <p
          class="chat-key-gate-copy"
        >
          On this page, chat uses 
          <strong>
            your own Anthropic API key
          </strong>
          . The key is stored only on this device — it is never sent to our servers, and your messages go directly from your browser to Anthropic. Usage is billed to your Anthropic account (typically well under a cent per question).
        </p>
        <p
          class="chat-key-gate-copy"
        >
          Prefer not to set one up? Chat is free at 
          <a
            href="https://drstanfield.com/pages/roadmap"
            rel="noopener noreferrer"
            target="_blank"
          >
            drstanfield.com
          </a>
          .
        </p>
        <div
          class="chat-key-gate-form"
        >
          <input
            aria-label="Anthropic API key"
            autocomplete="off"
            placeholder="sk-ant-…"
            type="password"
            value=""
          />
          <button
            disabled=""
            type="button"
          >
            Connect
          </button>
        </div>
        <p
          class="chat-key-gate-fineprint"
        >
          <a
            href="https://console.anthropic.com/settings/keys"
            rel="noopener noreferrer"
            target="_blank"
          >
            Get an API key from Anthropic →
          </a>
           Tip: create a dedicated key and set a low monthly spend limit on it.
        </p>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

