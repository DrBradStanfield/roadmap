    role="dialog"
  >
    <div
      class="chat-header"
    >
      <button
        class="chat-threads-btn"
      >
        History
      </button>
      <div
        class="chat-header-title-block"
      >
        <h3
          tabindex="-1"
        >
          Discuss your health
        </h3>
        <p
          class="chat-header-sub"
        >
          Answers cite your plan & the guidelines above
        </p>
      </div>
      <button
        aria-label="Close chat"
        class="chat-close-btn"
      >
        ✕
      </button>
    </div>
    <div
      class="chat-body"
    >
      <div
        class="chat-messages"
      >
        <div
          class="chat-message chat-message--user"
        >
          <div
            class="chat-message-content"
          >
            What is a good LDL?
          </div>
        </div>
        <p
          aria-live="polite"
          class="chat-pending-status"
        >
          Searching…
        </p>
        <div
          class="chat-message chat-message--assistant"
        >
          <div
            class="chat-loading chat-thinking-panel"
          >
            <span
              class="chat-thinking-label"
            >
              Thinking (draft notes, not the answer)
            </span>
            <p
              class="chat-sources"
            >
              Reading: LDL
            </p>
            <p
              class="chat-thinking-summary"
            >
              Reading the guideline
            </p>
          </div>
        </div>
      </div>
    </div>
    <div
      class="chat-input-bar"
    >
      <div
        class="chat-input-shell"
      >
        <textarea
          class="chat-input"
          disabled=""
          placeholder="Ask a follow-up…"
          rows="1"
        />
        <button
          aria-label="Send"
          class="chat-send-btn"
          disabled=""
        >
          ↑
        </button>
      </div>
      <div
        class="chat-input-meta"
      >
        <span
          class="chat-doctor-note"
        >
          Always discuss with your doctor
        </span>
        <span
          class="chat-char-count"
        >
          0/8000
        </span>
      </div>
    </div>
  </div>
</DocumentFragment>
`;
