              aria-labelledby=":id0:delete :id0:0"
              class="chat-thread-delete"
              title="Delete conversation"
            >
              ✕
            </button>
          </div>
          <div
            class="chat-thread-item "
            role="button"
            tabindex="0"
          >
            <span
              class="chat-thread-title"
              id=":id0:1"
            >
              Vitamin D
            </span>
            <button
              aria-labelledby=":id0:delete :id0:1"
              class="chat-thread-delete"
              title="Delete conversation"
            >
              ✕
            </button>
          </div>
        </div>
      </div>
      <div
        class="chat-embed-main"
      >
        <div
          class="chat-embed-main-header"
        >
          <button
            aria-label="Show conversations"
            class="chat-embed-threads-btn"
          >
            <svg
              aria-hidden="true"
              focusable="false"
              height="14"
              viewBox="0 0 16 16"
              width="14"
