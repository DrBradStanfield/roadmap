SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_JWT_SECRET=your-jwt-secret
SESSION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SENTRY_DSN=your-sentry-dsn
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=your-from-email
SHOPIFY_STORE_URL=your-store.myshopify.com
FEEDBACK_EMAIL=brad@drstanfield.com
SENTRY_AUTH_TOKEN=your-sentry-org-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_RELEASE=your-release-sha
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_TEST_API_KEY=your-test-workspace-key

# Cloud storage OAuth (Fly-only)
DROPBOX_APP_KEY=your-dropbox-app-key            # dropbox
DROPBOX_APP_SECRET=your-dropbox-app-secret      # dropbox
GOOGLE_DRIVE_CLIENT_ID=your-google-client-id    # drive
GOOGLE_DRIVE_SECRET=your-google-client-secret   # drive

# Hosted MCP server (Fly-only)
MCP_ISSUER=https://mcp.example.test             # issuer
MCP_SEAL_KEYS=base64-32-byte-key                # sealing
MCP_CLIENT_HMAC_KEY=base64-32-byte-key          # pinning
OPENAI_APPS_CHALLENGE=                          # chatgpt listing domain check
GITHUB_ISSUES_TOKEN=                            # files report_feedback issues
MCP_IMPORT_BUDGET_MS=40000                      # import_documents whole-call budget (ChatGPT cuts tool calls at 60 s)
MCP_KNOWLEDGE_TOOLS=off                         # on = search_knowledge and get_article
MCP_REVIEWER_VENDORS=openai                     # whose reviewer sign-in is open: openai and/or anthropic
MCP_REVIEWER_USERNAME=                          # reviewer sign-in: all three set, or it is off
MCP_REVIEWER_PASSWORD_SHA256=                   # 64 lowercase hex
MCP_REVIEWER_DROPBOX_RT=                        # reviewer's Dropbox refresh token

# iPhone app gate (edu app only)
APP_ATTEST_TEAM_ID=                             # unset = the app routes answer 503
APP_ATTEST_BUNDLE_ID=                           # unset = the app's own bundle id
APP_ATTEST_ALLOW_DEVELOPMENT=0                  # 1 = also accept development keys
APP_ATTEST_DEV_BYPASS=0                         # 1 = simulator bypass, only when NODE_ENV is development or test
APP_CHAT_DAILY_CAP=500                          # app chat turns per day, per machine
APP_LAB_DAILY_CAP=300                           # app lab reads per day, per machine (also capped at 15% of AI_DAILY_FILE_CAP)
WEB_CHAT_DAILY_CAP=10000                        # web chat turns per day, per machine; 0 = web chat off

# Shopify app
SHOPIFY_API_KEY=your-shopify-client-id          # client
SHOPIFY_API_SECRET=your-shopify-client-secret   # secret
SHOPIFY_APP_URL=https://your-app.fly.dev        # url
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com    # shop
SHOP_CUSTOM_DOMAIN=shop.example.com             # custom storefront domain
SCOPES=write_app_proxy,read_customers           # comma-separated app scopes
ADMIN_SHOP_DOMAIN=your-store.myshopify.com      # only this shop's admin may fire the manual cron pages; unset = any admin

# Email + marketing
KLAVIYO_API_KEY=your-klaviyo-private-key        # klaviyo
KLAVIYO_LIST_ID=YOURLIST                        # list
RESEND_WEBHOOK_SECRET=whsec_your-secret         # webhook

# Limits
AI_DAILY_FILE_CAP=100                           # cap, per machine, shared by the upload route and import_documents

# Chatbot
CHAT_ENABLED=true                               # toggle
CHAT_SURFACE=commerce                           # surface
CHAT_STREAMING=true                             # false = /api/chat ignores stream:true
CHAT_QUESTION_ARCHIVE=off                       # on = keep question copies at purge (docs/chat-question-archive)
TOPIC_MASTER_HIDE=on                            # off = the router may pick topic masters
CHAT_SUBSCRIPTION_ACTIONS=off                   # on (with CHAT_SURFACE=brand and the two below) = subscription actions in chat
CS_GATEWAY_CHAT_URL=                            # gateway base URL
CHAT_GATEWAY_SECRET=                            # 32+ chars, same value as the gateway's

# Message packs (Shopify variant ids; unset = no packs)
MESSAGE_PACK_25_VARIANT_ID=
MESSAGE_PACK_60_VARIANT_ID=
MESSAGE_PACK_150_VARIANT_ID=

# Discord bot (commerce app only)
DISCORD_BOT_TOKEN=your-discord-bot-token        # bot
DISCORD_SERVER_ID=000000000000000000            # guild
DISCORD_BOT_PROFILE_ID=000000000000000000       # profile
DISCORD_DrBradStanfield_USER_ID=000000000000000000  # Brad's user id
DISCORD_DEDICATED_AI_CHANNEL_ID=000000000000000000  # channel
DISCORD_EXCLUDED_CHANNEL_IDS=000000000000000000     # excluded

# YouTube bot (commerce app only)
YOUTUBE_BOT_CLIENT_ID=your-youtube-client-id    # client
YOUTUBE_BOT_CLIENT_SECRET=your-youtube-secret   # secret
YOUTUBE_BOT_REFRESH_TOKEN=your-refresh-token    # refresh
YOUTUBE_BOT_CHANNEL_ID=your-channel-id          # channel
YOUTUBE_BOT_PROFILE_ID=000000000000000000       # profile
YOUTUBE_BOT_SUMMARY_EMAIL=you@example.com       # digest

# Local development only (the bots start on Fly by themselves)
DISCORD_FORCE_START=false                       # true = start the Discord bot off Fly
YOUTUBE_BOT_FORCE_START=false                   # true = start the YouTube bot off Fly
