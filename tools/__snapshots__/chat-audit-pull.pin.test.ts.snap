exports[`chat-audit-pull golden pins (pre-split) > console lines 1`] = `
"
Chat Audit Pull
  Mode:       --from-existing (skip Supabase, re-render from JSON)
  Source dir: <DIR>
  Output dir: <DIR>
  HTML:       yes

Loaded 8 messages, 6 routing events from existing JSON
Wrote conversations.md
Wrote conversations.html

Summary:
  4 conversations
  4 web user turns
  1 Discord user turns

Next: open <DIR>/conversations.html and triage against the 11 quality dimensions.
See chat-start-here.md for the full audit playbook.
"
`;

