<div id="health-chat-root"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  {% if routes.account_login_url %}data-login-url="{{ routes.account_login_url }}"{% endif %}
  {% if product %}data-product-title="{{ product.title | escape }}"{% endif %}
  style="display:none">
</div>

{{ 'health-site-chat.css' | asset_url | stylesheet_tag }}
{{ 'health-site-chat.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Health Chat",
  "target": "body",
  "settings": []
}
{% endschema %}
