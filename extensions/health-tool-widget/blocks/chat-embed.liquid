{%- comment -%}
  Hide the floating chat bubble on the Health Roadmap page — that page
  already has its own chat entry point via the widget FAB.
{%- endcomment -%}
{%- unless page.handle == 'roadmap' -%}
<div id="health-chat-root"
  data-logged-in="{% if customer %}true{% else %}false{% endif %}"
  {% if routes.account_login_url %}data-login-url="{{ routes.account_login_url }}"{% endif %}
  {% if product %}data-product-title="{{ product.title | escape }}"{% endif %}
  style="display:none">
</div>

{{ 'health-site-chat.css' | asset_url | stylesheet_tag }}
{{ 'health-site-chat.js' | asset_url | script_tag }}

{%- if template.name == 'index' -%}
<style>@media (max-width: 767px) { #health-chat-root { display: none; } }</style>
{%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Health Chat",
  "target": "body",
  "settings": []
}
{% endschema %}
