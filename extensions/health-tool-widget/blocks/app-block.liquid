<!-- Health Roadmap — v2 LOCAL-FIRST (production cutover 2026-06-12).
     User-owned storage (their own cloud / localStorage), no Supabase, chat +
     lab-upload through Brad's thin server. Same bundle family as the GitHub
     Pages build. The legacy Supabase-backed widget (health-tool.js) was RETIRED
     on 2026-06-15 — its bundle and entry are gone, and its API hit now-deleted
     server endpoints + purged tables, so it offered no working rollback. To roll
     back, git revert the teardown commits and rebuild from source. -->
{{ 'health-plan-v2.css' | asset_url | stylesheet_tag }}
<style>
  #upCartStickyButton, #PBarNextFrameWrapper { display: none !important; }
  /* `clip` (not `hidden`) so body doesn't become a scroll container — `hidden`
     silently breaks `position: sticky` on descendants. */
  html, body { overflow-x: hidden; overflow-x: clip; }
</style>

<header class="hr-hero">
  <div class="hr-hero-text">
    <h1>Get Your Personalized Health Plan</h1>
    <p>Enter your health information below to receive personalized suggestions to discuss with your healthcare provider. The more information you provide, the more tailored your suggestions will be.</p>
  </div>
  <img
    class="hr-hero-img"
    src="https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=800"
    alt="Dr Brad Stanfield"
    loading="eager"
  />
</header>

<!-- data-logged-in=true: the local-first store IS the data layer (no Shopify
     login in v2); sync status renders inside the plan panel via syncControl. -->
<!-- Loading skeleton: paints before health-plan-v2.js loads so the widget box
     is reserved at ~its real above-the-fold size (near-zero layout shift). React
     replaces these children on mount. Shimmer styles live in health-plan-v2.css
     (.hr-skeleton*). NBSP inside each block dodges the storefront's
     `div:empty { display:none }` rule. -->
<div
  id="health-tool-root"
  data-logged-in="true"
  data-upload-url="{{ 'health-upload.js' | asset_url }}"
  data-assistant-name="{{ shop.metafields.health_roadmap.chat_assistant_name | default: 'Brad AI' | escape }}"
>
  <div class="hr-skeleton" aria-hidden="true">
    <div class="hr-skel-tabbar">&nbsp;</div>
    <div class="hr-skeleton-content">
      <div class="hr-skeleton-col">
        <div class="hr-skel-colhead">&nbsp;</div>
        <div class="hr-skel-card">
          <div class="hr-skel-line hr-skel-line--title">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--input">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--input">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--input">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--input">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--input">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--med">&nbsp;</div>
        </div>
      </div>
      <div class="hr-skeleton-col">
        <div class="hr-skel-colhead">&nbsp;</div>
        <div class="hr-skel-card">
          <div class="hr-skel-line hr-skel-line--title">&nbsp;</div>
          <div class="hr-skel-line">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--med">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--short">&nbsp;</div>
        </div>
      </div>
      <div class="hr-skeleton-col">
        <div class="hr-skel-colhead">&nbsp;</div>
        <div class="hr-skel-card">
          <div class="hr-skel-line hr-skel-line--title">&nbsp;</div>
          <div class="hr-skel-line">&nbsp;</div>
          <div class="hr-skel-line hr-skel-line--med">&nbsp;</div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="module" src="{{ 'health-plan-v2.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Health Roadmap Tool",
  "target": "section",
  "settings": []
}
{% endschema %}
