<!-- Health Roadmap Tool - React Version -->
{% unless customer %}
  {% assign login_url = routes.account_url %}
{% endunless %}

<!-- CSS first so skeleton is styled immediately -->
{{ 'health-tool.css' | asset_url | stylesheet_tag }}
<style>
  #upCartStickyButton, #PBarNextFrameWrapper { display: none !important; }
  html, body { overflow-x: hidden; }
</style>

{% unless customer %}
<script>
(function() {
  try {
    if (!localStorage.getItem('health_roadmap_authenticated')) return;
    if (sessionStorage.getItem('health_roadmap_auth_redirect')) {
      localStorage.removeItem('health_roadmap_data');
      localStorage.removeItem('health_roadmap_authenticated');
      return;
    }
    sessionStorage.setItem('health_roadmap_auth_redirect', '1');
    window.location.href = '{{ routes.account_url | default: "/account" }}' +
      '?return_url=' + encodeURIComponent(window.location.pathname + window.location.search);
  } catch(e) {}
})();
</script>
{% endunless %}

<!-- Hero: outside React mount point, never replaced by JS -->
{% assign ab_config = shop.metafields.health_roadmap.ab_config.value %}
{% assign heading_test = nil %}
{% assign subheading_test = nil %}
{% assign email_helper_test = nil %}
{% if ab_config.testId %}
  {% comment %}Legacy single-test format{% endcomment %}
  {% if ab_config.target == 'heading' %}{% assign heading_test = ab_config %}{% endif %}
  {% if ab_config.target == 'subheading' %}{% assign subheading_test = ab_config %}{% endif %}
{% else %}
  {% comment %}New array format{% endcomment %}
  {% for test in ab_config %}
    {% if test.target == 'heading' %}{% assign heading_test = test %}{% endif %}
    {% if test.target == 'subheading' %}{% assign subheading_test = test %}{% endif %}
    {% if test.target == 'email-guest-helper' %}{% assign email_helper_test = test %}{% endif %}
  {% endfor %}
{% endif %}
{% assign default_heading = "Get Your Personalized Health Plan" %}
{% assign default_subheading = "Enter your health information below to receive personalized suggestions to discuss with your healthcare provider. The more information you provide, the more tailored your suggestions will be." %}
<div class="hero-section">
  <div class="hero-text">
    {% if heading_test %}
      {% for variant in heading_test.variants %}
        <h1 data-variant="{{ variant.id }}" data-test="{{ heading_test.testId }}"
            {% unless forloop.first %}style="display:none"{% endunless %}>
          {{ variant.value }}
        </h1>
      {% endfor %}
    {% else %}
      <h1>{{ default_heading }}</h1>
    {% endif %}
    {% if subheading_test %}
      {% for variant in subheading_test.variants %}
        <p data-variant="{{ variant.id }}" data-test="{{ subheading_test.testId }}"
           {% unless forloop.first %}style="display:none"{% endunless %}>
          {{ variant.value }}
        </p>
      {% endfor %}
    {% else %}
      <p>{{ default_subheading }}</p>
    {% endif %}
  </div>
  <div class="hero-image">
    <img
      src="https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=800"
      srcset="
        https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=200 200w,
        https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=400 400w,
        https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=800 800w,
        https://cdn.shopify.com/s/files/1/0736/2907/3693/files/SMILING_2.webp?v=1754525200&width=900 900w"
      sizes="(max-width: 768px) 25vw, 45vw"
      width="800"
      height="1000"
      fetchpriority="high"
      alt="Dr Brad Stanfield">
  </div>
</div>

{% if email_helper_test %}
  <div style="display:none" aria-hidden="true">
    {% for variant in email_helper_test.variants %}
      <span class="ab-email-helper" data-variant="{{ variant.id }}" data-test="{{ email_helper_test.testId }}">{{ variant.value }}</span>
    {% endfor %}
  </div>
{% endif %}

<script>
(function() {
  var KEY = 'hr_ab';
  var els = document.querySelectorAll('[data-variant]');
  if (!els.length) return;

  // Group by test ID
  var groups = {};
  els.forEach(function(e) {
    var tid = e.dataset.test;
    if (!groups[tid]) groups[tid] = { ids: [], els: [] };
    groups[tid].els.push(e);
    if (groups[tid].ids.indexOf(e.dataset.variant) < 0) groups[tid].ids.push(e.dataset.variant);
  });

  // Load stored assignments (handle old {t,v} and new {tests:{}} format)
  // Format shared with getABAssignments() in widget-src/src/lib/api.ts
  var raw = {};
  try { raw = JSON.parse(localStorage.getItem(KEY)) || {}; } catch(e) {}
  var tests = {};
  if (raw.tests) {
    tests = raw.tests;
  } else if (raw.t && raw.v) {
    tests[raw.t] = raw.v;
  }

  // Assign per test group
  var activeIds = {};
  Object.keys(groups).forEach(function(tid) {
    activeIds[tid] = 1;
    var g = groups[tid];
    var v = tests[tid];
    if (!v || g.ids.indexOf(v) < 0) {
      v = g.ids[Math.floor(Math.random() * g.ids.length)];
    }
    tests[tid] = v;
    g.els.forEach(function(e) { e.style.display = e.dataset.variant === v ? '' : 'none'; });
  });

  // Clean up stale assignments (tests no longer in DOM)
  Object.keys(tests).forEach(function(tid) {
    if (!activeIds[tid]) delete tests[tid];
  });

  localStorage.setItem(KEY, JSON.stringify({ tests: tests }));
})();
</script>

<div id="health-tool-root"
  {% if customer %}
    data-logged-in="true"
    data-account-url="{{ routes.account_url }}"
  {% else %}
    data-logged-in="false"
  {% endif %}
  {% if login_url %}data-login-url="{{ login_url }}"{% endif %}
  data-upload-url="{{ 'health-upload.js' | asset_url }}"
>
  <!-- Static skeleton: replaced when React mounts -->
  <div class="health-tool">
    <div class="health-tool-content">
      <div class="health-tool-left">
        <!-- Matches stage-1 profile form: section padding + Units + Sex + Height fields -->
        <div class="skeleton-block" style="height:280px"></div>
      </div>
      <div class="health-tool-right">
        {% unless customer %}
        <div class="skeleton-block" style="height:52px"></div>
        {% endunless %}
        <div class="skeleton-block" style="height:220px"></div>
      </div>
    </div>
  </div>
</div>

<!-- Load React app with defer so skeleton renders while JS downloads -->
<script src="{{ 'health-tool.js' | asset_url }}" defer crossorigin="anonymous"></script>

{% schema %}
{
  "name": "Health Roadmap Tool",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Health Roadmap"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Enter your health information to receive personalized suggestions."
    }
  ]
}
{% endschema %}
