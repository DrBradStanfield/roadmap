{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge * --merge --match-head-commit *)"
    ],
    "deny": [
      "Bash(gh pr merge *--admin*)",
      "Bash(gh pr merge *--squash*)",
      "Bash(gh pr merge *--rebase*)",
      "Bash(gh pr merge *--auto*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *push*|*merge*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-push-guard.cjs\";; esac"
          },
          {
            "type": "command",
            "command": "input=$(cat); case \"$input\" in *xcodebuild*|*simctl*) printf '%s' \"$input\" | node \"$CLAUDE_PROJECT_DIR/.claude/hooks/simulator-guard.cjs\";; esac",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.cjs\"",
            "timeout": 300
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.cjs\""
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__(reply|send_message|create_draft|update_draft|forward)",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Documents/claude_business.nosync/.claude/hooks/email-style-guard.js\"; if [ -f \"$f\" ]; then node \"$f\"; else cat > /dev/null; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.cjs\"",
            "timeout": 45
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.cjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
